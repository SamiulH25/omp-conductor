#!/usr/bin/env node
// Append one concise line to the project-shared handoff notes file supplied by the plugin.
import { appendFileSync, existsSync, readFileSync } from 'node:fs'

const file = process.env.PI_NOTES_FILE
const line = process.argv.slice(2).join(' ').replace(/\s+/g, ' ').trim()
const MAX_CHARS = 4000
if (!file) {
  console.error('note: PI_NOTES_FILE is not set (run this inside an omp-conductor worker)')
  process.exit(2)
}
if (!line) {
  console.error('usage: note <one concise line for other workers>')
  process.exit(2)
}
let current = ''
try {
  if (existsSync(file)) current = readFileSync(file, 'utf8')
} catch (error) {
  console.error(`note: cannot read notes file: ${error.message}`)
  process.exit(1)
}
const addition = `${current && !current.endsWith('\n') ? '\n' : ''}${line}\n`
if (current.length + addition.length > MAX_CHARS) {
  console.error(`note: notes are capped at ${MAX_CHARS} characters; append would exceed the cap`)
  process.exit(1)
}
try {
  appendFileSync(file, addition, 'utf8')
  console.log(`note: appended (${current.length + addition.length}/${MAX_CHARS} chars)`)
} catch (error) {
  console.error(`note: cannot append notes: ${error.message}`)
  process.exit(1)
}
